# The committed .env already points at the live KaPamana project.
# To use a different project, copy this file to .env.local and fill in from Supabase: Project Settings → API.
# The anon key is public by design (protected by row level security).
# NEVER put the service_role key here or anywhere in the app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
